import logging
from typing import Any
from BD.users import db_users
logger = logging.getLogger(__name__)
def add_new_user(user_id: int, username: str) -> Any:
    if user_id in db_users:
        return
    else:
        db_users.update({user_id: {}})
        db_users[user_id].update({
            'username': username,
            'id': user_id,
            'opponents': {},
            'total_wins': 0,
            'total_matches': 0
        })
def create_opponent(user_id: int, opponent_id: int):
    if user_id in db_users and opponent_id in db_users:
        if opponent_id not in db_users[user_id]['opponents']:
            new_opponent = {opponent_id: {
                'username': db_users[opponent_id]['username'],
                'id': db_users[opponent_id]['id'],
                }
            }
            db_users[user_id]['opponents'].update(new_opponent)
            new_o_opponent = {user_id: {
                'username': db_users[user_id]['username'],
                'id': db_users[user_id]['id'],
                }
            }
            db_users[opponent_id]['opponents'].update(new_o_opponent)
def update_opponents_data(user_id: int, opponent_id: int, draw: bool) -> Any:
    user = db_users[user_id]
    cur_draws_u = db_users[user_id]['opponents'][opponent_id].setdefault('draws', 0)
    cur_draws_o = db_users[opponent_id]['opponents'][user_id].setdefault('draws', 0)
    cur_wins_u = db_users[user_id]['opponents'][opponent_id].setdefault('wins', 0)
    cur_wins_o = db_users[opponent_id]['opponents'][user_id].setdefault('wins', 0)
    cur_tot_u = db_users[user_id]['opponents'][opponent_id].setdefault('total_games', 0)
    cur_tot_o = db_users[opponent_id]['opponents'][user_id].setdefault('total_games', 0)
    if draw:
        db_users[user_id]['opponents'][opponent_id].update({'draws': cur_draws_u + 1})
        db_users[user_id]['opponents'][opponent_id].update({'total_games': cur_tot_u + 1})
        db_users[opponent_id]['opponents'][user_id].update({'draws': cur_draws_o + 1})
        db_users[opponent_id]['opponents'][user_id].update({'total_games': cur_tot_o + 1})
        return
    all_wins = user.setdefault('total_wins', 0)
    user.update({'total_wins': all_wins + 1})
    db_users[user_id]['opponents'][opponent_id].update({'wins': cur_wins_u + 1})
    db_users[user_id]['opponents'][opponent_id].update({'total_games': cur_tot_u + 1})
    db_users[opponent_id]['opponents'][user_id].update({'total_games': cur_tot_o + 1})
def get_username(user_id) -> str:
    if user_id in db_users:
        if db_users[user_id]["username"]:
            cur_username = db_users[user_id]["username"]
        else:
            cur_username = db_users[user_id]["id"]
        return str(cur_username)
