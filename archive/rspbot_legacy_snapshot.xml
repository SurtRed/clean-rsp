import logging
import time
from datetime import datetime
from typing import Any, Awaitable, Callable, Dict
import json
from aiogram.types import CallbackQuery, Message, InlineQuery, ChosenInlineResult
from aiogram import BaseMiddleware
from services.middleware_tools import get_event_content_type, output_rooms_infos
from BD.rooms import db_obj_rooms
from lexicon.lexicon_ru import LEXICON_RU_COMMANDS
logger = logging.getLogger(__name__)
class OuterMessageMiddleware(BaseMiddleware):
    async def __call__(
        self,
        handler: Callable[[Message, Dict[str, Any]], Awaitable[Any]],
        event: Message,
        data: Dict[str, Any]
    ) -> Any:
        ev = event.model_dump()
        ev_json = json.dumps(event.model_dump(exclude_unset=True, exclude_defaults=True), indent=3)
        event_name = event.__class__.__name__
        event_content_type = event.content_type.__dict__["_value_"]
        date_time = ev["date"]
        reg_date_time = time.localtime(float(date_time))
        print_time = time.strftime("%B %d %Y at %H:%M:%S", reg_date_time)
        logger.debug(
            '\n\t\t\t\t\t\t\t время апдейта:\t\t\t\t%s\n\t\t\t\t\t\t\t тип апдейта:\t\t\t\t%s'
            '\n\t\t\t\t\t\t\t тип контента:\t\t\t\t%s\n'
