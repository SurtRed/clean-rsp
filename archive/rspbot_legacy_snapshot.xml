from keyboards.inline_keyboards import kb_for_duo
from lexicon.lexicon_ru import LEXICON_RU
from typing import Any
from BD.users import db_users
from services.db_tools.users_tools import create_opponent, get_username
from services.tools import get_bot_choice
from aiogram.types import InlineKeyboardMarkup
from keyboards.inline_keyboards import buttons_dict
class Room:
    room_id = ''
    def __init__(self, room_id):
        self.stats = ""
        self.room_id = room_id
        self.player1 = {}
        self.player2 = {}
        self.players_wins = {}
        self.players_score = {}
        self.total_matches = 0
        self.draws = 0
        self.is_solo = False
        self.both_turn = False
        self.turn_in_row = 1
        self.caption = LEXICON_RU["/start"]
        self.solo_caption = LEXICON_RU["solo_do_turn"]
        self.markup = kb_for_duo
        self.players_list = set()
    def __del__(self):
        print(f"УДАЛИЛИ КОМНАТУ С НОМЕРОМ {self.room_id}")
    def set_solo_player(self, player_id: int):
        loc = LEXICON_RU
        cur_username = get_username(player_id)
        self.is_solo = True
        if 'username' not in self.player1:
            self.player1.update(username=cur_username)
            self.player1.update(id=player_id)
            self.players_score.update({player_id: 0})
            self.players_list.add(player_id)
            href_player = f'<b><a href=\"tg://user?id={player_id}\">{get_username(player_id)}</a></b>'
            self.solo_caption = f"{loc['s_title']}\nРаунд {self.turn_in_row}\n\n"
            self.solo_caption += f'{loc['player1']}: \n{loc['hm']}\t{href_player}\t{loc['thinking']}\t\n\n'
            self.set_player_bot()
        self.markup = InlineKeyboardMarkup(
            inline_keyboard=[
                buttons_dict['rock'],
                buttons_dict['scissors'],
                buttons_dict['paper'],
                buttons_dict['score_tab'],
                buttons_dict['cancel_game']
            ]
        )
    def set_player1(self, player_id: int):
        cur_username = get_username(player_id)
        self.is_solo = False
        if 'username' not in self.player1:
            self.player1.update(username=cur_username)
            self.player1.update(id=player_id)
            self.players_score.update({player_id: 0})
            self.caption = self.get_caption()
            self.players_list.add(player_id)
            but_copy = buttons_dict['accept_from_but'][0].copy()
            but_copy.text += get_username(player_id)
            self.markup = InlineKeyboardMarkup(
                inline_keyboard=[
                    [but_copy],
                    buttons_dict['cancel_game'],
                ]
            )
    def set_player_bot(self):
        loc = LEXICON_RU
        self.player2.update(id=6270185948)
        self.player2.update(username="ИИ")
        self.players_score.update({6270185948: 0})
        self.players_list.add(6270185948)
        self.set_turn(6270185948, get_bot_choice())
        href_bot = f'<b><a href=\"tg://user?id={6270185948}\">ИИ</a></b>'
        self.solo_caption += f'{loc['player2']}: \n{loc['ready']}\t{href_bot}\t{loc['turn_done']}\t\n\n'
    def set_player2(self, player_id: int):
        cur_username = get_username(player_id)
        if 'username' not in self.player2:
            self.player2.update(username=cur_username)
            self.player2.update(id=player_id)
            self.players_score.update({player_id: 0})
            self.caption = self.get_caption()
            self.players_list.add(player_id)
            self.markup = InlineKeyboardMarkup(
                    inline_keyboard=[
                        buttons_dict['rock'],
                        buttons_dict['scissors'],
                        buttons_dict['paper'],
                        buttons_dict['score_tab'],
                        buttons_dict['cancel_game']
                    ]
                )
    def cancel_game(self, player_id: int):
        self.both_turn = False
        self.turn_in_row = 1
        self.player1 = {}
        self.player2 = {}
        self.caption = (f"Игрок <a href=\"tg://user?id={player_id}\">{get_username(player_id)}\t</a>"
                        f"{LEXICON_RU['cancelling_game']}")
        self.markup: InlineKeyboardMarkup = kb_for_duo
    def get_player_num(self, player_id: int) -> str:
        cur_id: int = 0
        if player_id in db_users:
            cur_id = player_id
        if cur_id in self.player1.values():
            return "player1"
        if cur_id in self.player2.values():
            return "player2"
        return ""
    def is_player1(self, player_id: int) -> bool:
        if player_id in self.player1.values():
            return True
        else:
            return False
    def is_player2(self, player_id: int) -> bool:
        if player_id in self.player2.values():
            return True
        else:
            return False
    def set_turn(self, player_id: int, turn: str):
        if self.is_player1(player_id):
            self.player1.update(turn=turn)
            if self.is_solo:
                self.player2.update(turn=get_bot_choice())
        if self.is_player2(player_id):
            self.player2.update(turn=turn)
        if 'turn' in self.player1 and 'turn' in self.player2:
            self.both_turn = True
        self.markup = InlineKeyboardMarkup(
            inline_keyboard=[
                buttons_dict['rock'],
                buttons_dict['scissors'],
                buttons_dict['paper'],
                buttons_dict['score_tab'],
                buttons_dict['cancel_game']
            ]
        )
        self.caption = self.get_caption()
    def get_turn(self, player_id: int) -> str:
        cur_player_num = self.get_player_num(player_id)
        if cur_player_num == 'player1' and 'turn' in self.player1:
            return self.player1['turn']
        if cur_player_num == 'player2' and 'turn' in self.player2:
            return self.player2['turn']
        return ""
    def get_player1_status(self) -> str:
        player1 = ""
        waiting_invite = LEXICON_RU['waiting_for_accept_invite']
        turn_done = LEXICON_RU['turn_done']
        thinking = LEXICON_RU['thinking']
        result = ""
        if 'username' in self.player1:
            player1 = self.player1['username']
            result = f"Игрок 1:\n{player1}\n\n"
        else:
            result = f"Игрок 1:\n\t{waiting_invite}"
        if 'turn' in self.player1:
            player1 = self.player1['username']
            result = f"Игрок 1: \n{player1}\t{turn_done}\t\n\n"
        elif 'turn' in self.player2:
            result = f"Игрок 1: \n{player1}\t{thinking}\t\n\n"
        return result
    def get_player2_status(self) -> str:
        player2 = ""
        waiting_invite = LEXICON_RU['waiting_for_accept_invite']
        turn_done = LEXICON_RU['turn_done']
        thinking = LEXICON_RU['thinking']
        result = ""
        if "username" in self.player2:
            player2 = self.player2['username']
            result = f"Игрок 2:\n{player2}"
        else:
            result = f"Игрок 2:\n\t{waiting_invite}"
        if "turn" in self.player2:
            player2 = self.player2['username']
            result = f"Игрок 2: \n{player2}\t{turn_done}\t"
        elif 'turn' in self.player1:
            result = f"Игрок 2: \n{player2}\t{thinking}\t"
        return result
    def get_caption(self) -> str:
        if self.both_turn:
            return self.get_winner_caption()
        title = f"{LEXICON_RU['s_title']}\t\t\nРаунд {self.turn_in_row}"
        return f"{title}\n\n{self.get_player1_status()}{self.get_player2_status()}"
    def get_winner_caption(self) -> str:
        loc = LEXICON_RU
        rules = {'rock': 'scissors',
                 'scissors': 'paper',
                 'paper': 'rock'}
        self.markup = InlineKeyboardMarkup(
            inline_keyboard=[
                buttons_dict['rock'],
                buttons_dict['scissors'],
                buttons_dict['paper'],
                buttons_dict['score_tab'],
                buttons_dict['cancel_game']
            ]
        )
        if self.player1['id'] not in db_users[self.player2['id']]['opponents'].values():
            create_opponent(self.player1['id'], self.player2['id'])
        p1_turn = LEXICON_RU[self.player1.get('turn')]
        p2_turn = LEXICON_RU[self.player2.get('turn')]
        p1_id = self.player1['id']
        p2_id = self.player2['id']
        p1_name = str(self.player1.get('username'))
        p2_name = str(self.player2.get('username'))
        href1 = f'<b><a href=\"tg://user?id={p1_id}\">{p1_name}</a></b>'
        href2 = f'<b><a href=\"tg://user?id={p2_id}\">{p2_name}</a></b>'
        serial = f'<b>{loc['s_title']}\n{loc['round']} {self.turn_in_row}\n</b>'
        player1_str = f'\n{loc['player1']}:\n'
        player1_turn = f'{href1}\t-\t{p1_turn}'
        player2_str = f'\n\n{loc['player2']}:\n'
        player2_turn = f'{href2}\t-\t{p2_turn}'
        res = serial
        if p1_turn == p2_turn:
            self.update_room_results(True, self.player1['id'], self.player2['id'])
            res += player1_str + loc['draw_icon'] + player1_turn + player2_str + loc['draw_icon'] + player2_turn
            return res
        elif rules[self.player1['turn']] == self.player2['turn']:
            self.update_room_results(False, self.player1['id'], self.player2['id'])
            res += player1_str + loc['cup'] + player1_turn + player2_str + loc['loss'] + player2_turn
            return res
        else:
            self.update_room_results(False, self.player2['id'], self.player1['id'])
            res += player1_str + loc['loss']  + player1_turn + player2_str + loc['cup'] + player2_turn
            return res
    def show_room_stats(self):
        x = (f"В этой комнате всего сыграно {self.total_matches} игр\n\n"
                        f"Счёт игроков комнаты: \n")
        for player in self.players_list:
            if player not in self.players_wins:
                self.players_wins.update({player: 0})
            href = f'<b><a href=\"tg://user?id={player}\">{get_username(player)}</a></b>'
            x += f"{href}\t{self.players_wins[player]}\n"
        x += f"В ничью:\t{self.draws}\n"
        self.markup = InlineKeyboardMarkup(
            inline_keyboard=[
                buttons_dict['back_to_game'],
                buttons_dict['cancel_game']
            ]
        )
        self.stats = x
    def returning_to_game(self):
        self.caption = self.get_caption()
        self.markup = InlineKeyboardMarkup(
            inline_keyboard=[
                buttons_dict['rock'],
                buttons_dict['scissors'],
                buttons_dict['paper'],
                buttons_dict['score_tab'],
                buttons_dict['cancel_game']
            ]
        )
    def update_room_results(self, draw: bool, player1_id: int, player2_id: int) -> Any:
        if draw:
            self.draws += 1
        else:
            if player1_id not in self.players_wins:
                self.players_wins.update({player1_id: 0})
            score = self.players_score.get(player1_id) + 1
            wins = self.players_wins.get(player1_id) + 1
            self.players_score.update({player1_id: score})
            self.players_wins.update({player1_id: wins})
        self.turn_in_row += 1
        self.total_matches += 1
        self.both_turn = False
        self.player1.pop('turn')
        self.player2.pop('turn')
    def get_total(self):
        print(self.room_id)
