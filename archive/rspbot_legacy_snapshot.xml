from aiogram.types import Message, CallbackQuery, InlineQuery, Message, Update, ChosenInlineResult
from BD.rooms import db_obj_rooms
from typing import Union
from aiogram.filters import BaseFilter
class IsSelfBotChat(BaseFilter):
    async def __call__(self, update: Union[Message, CallbackQuery]) -> bool:
        if isinstance(update, Message):
            if update.chat.id == update.from_user.id:
                return True
            else:
                return False
        elif isinstance(update, CallbackQuery):
            if update.from_user.id == update.message.chat.id:
                return True
            else:
                return False
class IsRoomMissing(BaseFilter):
    async def __call__(self, callback: CallbackQuery) -> bool:
        if callback.inline_message_id in db_obj_rooms:
            return False
        else:
            return True
class IsViaSelfBot(BaseFilter):
    async def __call__(self, message: Message) -> bool:
        if IsSelfBotChat():
            if message.via_bot:
                if message.via_bot.id == 6270185948:
                    return True
                else:
                    return False
            else:
                return False
        else:
            return False
class IsInlineMode(BaseFilter):
    async def __call__(self, callback: CallbackQuery) -> bool:
        if callback.inline_message_id:
            return True
        else:
            return False
class ExpectedUser(BaseFilter):
    async def __call__(self, callback: CallbackQuery) -> bool:
        if callback.inline_message_id:
            room = db_obj_rooms[callback.inline_message_id]
        else:
            room = db_obj_rooms[str(callback.message.chat.id)+str(callback.message.message_id)]
        result = callback.from_user.id not in room.player1.values() and callback.from_user.id not in room.player2.values()
        return result
class OnlyOneTurn(BaseFilter):
    async def __call__(self, callback: CallbackQuery) -> bool:
        if callback.inline_message_id:
            room = db_obj_rooms[callback.inline_message_id]
            res = not room.get_turn(callback.from_user.id)
            return res
        if callback.message:
            room = db_obj_rooms[str(callback.message.chat.id)+str(callback.message.message_id)]
            res = not room.get_turn(callback.from_user.id)
            return res
        return False
class AdmittedPlayer(BaseFilter):
    async def __call__(self, callback: CallbackQuery) -> bool:
        player_id = callback.from_user.id
        if callback.inline_message_id:
            room = db_obj_rooms[callback.inline_message_id]
        else:
            room = db_obj_rooms[str(callback.message.chat.id)+str(callback.message.message_id)]
        return player_id in room.player1.values() or player_id in room.player2.values()
