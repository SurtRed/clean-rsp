    add_new_user(callback.from_user.id, callback.from_user.username)
    cur_room = db_obj_rooms[str(callback.message.chat.id)+str(callback.message.message_id)]
    cur_room.set_player1(callback.from_user.id)
    await bot.edit_message_caption(
        chat_id=callback.message.chat.id,
        message_id=callback.message.message_id,
        caption=cur_room.caption,
        reply_markup=cur_room.markup
